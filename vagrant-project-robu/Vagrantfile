Vagrant.configure("2") do |config|
  # Database server first (so key exists before web needs it)
  config.vm.define "db" do |db|
    db.vm.box = "ubuntu/jammy64"
    db.vm.hostname = "db"
    db.vm.network "private_network", ip: "192.168.56.12"
    db.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end
    db.vm.provision "shell", inline: <<-SHELL
      apt-get update -y
      apt-get install -y mysql-server
    SHELL
  end

  # Web server
  config.vm.define "web" do |web|
    web.vm.box = "ubuntu/jammy64"
    web.vm.hostname = "web"
    web.vm.network "private_network", ip: "192.168.56.11"
    web.vm.network "forwarded_port", guest: 80, host: 8081
    web.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end
    web.vm.provision "shell", inline: <<-SHELL
      apt-get update -y
      apt-get install -y apache2
      echo "Hello from the Web Server!" > /var/www/html/index.html

      # Prepare SSH for connecting to DB
      mkdir -p /home/vagrant/.ssh
      cp /vagrant/.vagrant/machines/db/virtualbox/private_key /home/vagrant/.ssh/db_key
      chown vagrant:vagrant /home/vagrant/.ssh/db_key
      chmod 600 /home/vagrant/.ssh/db_key
      cat <<EOF >> /home/vagrant/.ssh/config
Host db
  HostName 192.168.56.12
  User vagrant
  IdentityFile /home/vagrant/.ssh/db_key
  StrictHostKeyChecking no
EOF
      chown vagrant:vagrant /home/vagrant/.ssh/config
      chmod 600 /home/vagrant/.ssh/config
    SHELL
  end
end
